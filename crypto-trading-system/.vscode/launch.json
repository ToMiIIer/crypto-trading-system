{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pipeline: Validate config",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": ["validate-config"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline: Run once",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": ["run-once", "--pair", "BTC/USDC", "--timeframe", "4h"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline: Run once (LLM)",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": ["run-once", "--pair", "BTC/USDC", "--timeframe", "4h"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline: Export dashboard",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": ["export-dashboard"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline: Run once (and store + export)",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": ["run-once", "--pair", "BTC/USDC", "--timeframe", "4h"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "EXPORT_DASHBOARD_ON_FINISH": "true"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline: Paper smoke (BUY->SELL)",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": ["paper-smoke", "--pair", "BTC/USDC", "--timeframe", "4h"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "EXECUTION_MODE": "paper",
        "EXPORT_DASHBOARD_ON_FINISH": "true",
        "TELEGRAM_NOTIFY_TRADES": "true"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Telegram: Send test notification",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/telegram_test_notify.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Telegram: Test trade notifications",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/telegram_test_trade_notify.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
