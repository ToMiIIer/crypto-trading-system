# Runtime
ENV=dev
LOG_LEVEL=INFO
DATA_DIR=data
REPORTS_DIR=reports
EXPORT_DASHBOARD_ON_FINISH=false

# Database (optional: defaults to sqlite at ./data/crypto_trading_system.db)
DATABASE_URL=

# Optional Redis endpoint (reserved for future queueing/cache)
REDIS_URL=redis://localhost:6379/0

# Telegram alerts
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TOKEN
TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_OR_LEAVE_BLANK
TELEGRAM_NOTIFY_PIPELINE=true
TELEGRAM_NOTIFY_PIPELINE_FINISH=1
TELEGRAM_NOTIFY_TRADES=1
TELEGRAM_NOTIFY_INCLUDE_RUN_STATS=1

# Analysis mode controls (execution off by default)
TRADING_ENABLED=false
EXECUTION_MODE=disabled

# LLM analysis
LLM_PROVIDER=auto
LLM_MODEL=
LLM_API_KEY=
LLM_STRICT_VALIDATION=false

# Optional external sentiment/news providers
SENTIMENT_API_KEY=
NEWS_API_KEY=

# Optional LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
