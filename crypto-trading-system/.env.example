# Runtime
ENV=dev
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/crypto_trading

# Optional Redis endpoint (reserved for future queueing/cache)
REDIS_URL=redis://localhost:6379/0

# Telegram alerts
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TOKEN
TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_OR_LEAVE_BLANK
TELEGRAM_NOTIFY_PIPELINE_FINISH=1
TELEGRAM_NOTIFY_TRADES=1
TELEGRAM_NOTIFY_INCLUDE_RUN_STATS=1

# Optional LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
